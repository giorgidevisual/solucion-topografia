---
import { secondHand } from "@components/consts/secondHand";
import SecondHandItem from "./SecondHandItem.astro";
---

<article class="second-hand-section">
  <main class="second-hand-wrapper">
    <header class="second-hand-header">
      <h2 class="title">Compra Segunda Mano</h2>
      <p class="text">
        Encontrarás aquí equipos de segunda mano de alta calidad, perfectos para
        tus proyectos.
      </p>
      <button>Quiero ver los equipos</button>
    </header>
    <section class="second-hand-content">
      {secondHand.map((item) => <SecondHandItem {...item} />)}
    </section>
  </main>
</article>

<style>
  .second-hand-section {
    background-color: var(--primary-color);
    padding: 3rem;
  }
  .second-hand-wrapper {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .second-hand-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--base-color);

  }
  .second-hand-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  button {
    letter-spacing: .5px;
    text-transform: uppercase;
    font-size: var(--text);
    background-color: var(--base-color);
    border:none;
    border-radius: 50px;
    padding: 1rem 1.5rem;
    inline-size: fit-content;
    transition: all .1s ease ;
    margin-block-start: 2rem; 

    &:hover {
        background-color: var(--secondary-color);
        color: var(--base-color);
        transform: scale(1.1);
    }
  }
</style>
