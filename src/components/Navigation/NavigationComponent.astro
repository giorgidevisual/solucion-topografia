---
import ButtonNavigation from './ButtonNavigation.astro';
import iconEstacionTotal from '@assets/icon-estacion-total.svg?raw';
import iconGPS from '@assets/icon-gps.svg?raw';
import iconEscanerLaser from '@assets/icon-escaner-laser.svg?raw';
import iconTablet from '@assets/icon-tablet.svg?raw';
import iconCables from '@assets/icon-cables.svg?raw';
---
<div>
  <nav>
    <ButtonNavigation title="Estación Total" icon={iconEstacionTotal}/>
    <ButtonNavigation title="GPS" icon={iconGPS}/>
    <ButtonNavigation title="Escáner láser" icon={iconEscanerLaser}/>
    <ButtonNavigation title="Tablets" icon={iconTablet}/>
    <ButtonNavigation title="Accesorios" icon={iconCables}/>
    <ButtonNavigation title="Cables" icon={iconCables}/>
  </nav>
</div>

<style>
  div {
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    margin-block-start: -2rem;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    flex-wrap: wrap;
    max-inline-size: 1080px;
    gap: 3px;
    background-color: var(--back);
    border-radius: 25px;
    overflow: hidden;
    background-color: var(--base2-color);
    box-shadow: -1px 6px 6px rgba(0, 0, 0, 0.1);
    z-index: 1;
  }
</style>
