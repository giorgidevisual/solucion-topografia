---
const pages = Object.values(import.meta.glob('../pages/*.astro', { eager: true }));

// Extraer la ruta y el título de cada página
const pageLinks = pages.map((page:any) => {
  const path = page.url.replace('../pages', '').replace('.astro', '');
  const title = page.metadata?.title || path.replace('/', '');
  return { path, title };
});
---

<nav class="nav-links">
  {pageLinks.map((page) => (
    <a href={page.path}>{page.title}</a>
  ))}
</nav>
