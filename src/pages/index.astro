---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Navigation from '@components/Navigation.astro';
import NavigationComponent from '@components/navigation/NavigationComponent.astro';
import FeaturesSection from '@components/features/FeaturesSection.astro';
import ProductHighlight from '@components/product-highlights/ProductHighlight.astro';
import BentoRenting from '@components/bento-renting/BentoRenting.astro';
import SecondHandSection from '@components/second-hand/SecondHandSection.astro';
import "@styles/global.css";
---

<BaseLayout Title="Solución Topografía">
	<Navigation />
	<Hero />
	<NavigationComponent />
	<ProductHighlight />
	<BentoRenting />
	<FeaturesSection />	
	<SecondHandSection />
		
	
	<section>
		<div id="parent-div">Objetivo aquí</div>
		<button hx-get="/partials/clicked/"
			hx-trigger="click"
			hx-target="#parent-div"
			hx-swap="innerHTML"
		>
				¡Haz clic en mí!
		</button>
	</section>
</BaseLayout>
